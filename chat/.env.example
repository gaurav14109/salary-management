# The shared secret the BFF presents. Must match the BFF's and the salary API's.
GATEWAY_KEY=change-me

# Where the tools read from. On the compose network this is the service name.
SALARY_API_URL=http://api:8000

# Groq, used for its free tier. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

LOG_LEVEL=INFO
