# Copy to .env and fill in. devops/.env is read automatically by docker compose and
# is git-ignored - never commit a real key.

# https://console.groq.com/keys - free tier
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Shared secret between the BFF, the salary API and the chat service.
GATEWAY_KEY=local-dev-gateway-key-not-for-production
