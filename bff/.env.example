# Backend-for-frontend. This process holds the two things the browser must not see:
# the Keycloak client secret and the session encryption key.

OIDC_ISSUER=http://localhost:8080/realms/salary

# Only when this process cannot resolve the address above - i.e. inside a container
# network. See devops/docker-compose.yml. Empty on the host.
# OIDC_INTERNAL_ISSUER=http://keycloak:8080/realms/salary

OIDC_CLIENT_ID=salary-bff
OIDC_CLIENT_SECRET=local-dev-bff-secret-not-for-production

BFF_BASE_URL=http://localhost:8001
SPA_BASE_URL=http://localhost:5173

SALARY_API_URL=http://localhost:8000
CHAT_SERVICE_URL=http://localhost:8002

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_SECRET=6gXrC0gEwIJL8asC9ifwYE-XougVQpp8h_GBe2Z2HxI=

# Set true wherever the site is served over HTTPS.
COOKIE_SECURE=false
