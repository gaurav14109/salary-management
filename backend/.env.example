# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql+psycopg://salary:salary@localhost:5432/salary
# Keycloak. No signing secret: this application validates tokens, it does not issue them.
OIDC_ISSUER=http://localhost:8080/realms/salary
OIDC_AUDIENCE=salary-api

# ANTHROPIC_API_KEY belongs to the chat service, not here. See docs/architecture.md.
