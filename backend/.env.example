# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql+psycopg://salary:salary@localhost:5432/salary

# Proves a request came from the BFF. This service is told who the caller is by
# headers rather than by a token, so unset means every request is refused - fail
# closed, because the one misconfiguration that must never pass is a missing check
# reading as no check required. Must match the BFF's value exactly.
GATEWAY_KEY=local-dev-gateway-key-not-for-production

# No OIDC settings and no signing secret. This service never sees a token: the BFF
# verifies one on every request and forwards the decoded claims.

# ANTHROPIC_API_KEY belongs to the chat service, not here. See plan_doc/architecture.md.
